#!/bin/sh
# iso_test_runner — one entry point for every suite in this repo.
#
#   ./iso_test_runner                  every suite
#   ./iso_test_runner mutate session   named feature suites
#   ./iso_test_runner --unit           the in-crate unit suites
#   ./iso_test_runner --harness        the node harness suites
#   ./iso_test_runner --list           what would run, without running it
#
# A Rust feature suite is any tests/<name>.rs. Discovery is the whole
# registration step: adding a file adds a suite. Everything runs
# single-threaded, because the suites share one ISOHYPSE_STORE and collide on it
# in parallel.
set -eu
cd "$(dirname "$0")"

mode=all
wanted=""
for arg in "$@"; do
    case "$arg" in
        --list) mode=list ;;
        --unit) mode=unit ;;
        --harness) mode=harness ;;
        -h|--help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*) echo "iso_test_runner: unknown flag $arg" >&2; exit 2 ;;
        *) wanted="$wanted $arg" ;;
    esac
done

features=$(for f in tests/*.rs; do [ -e "$f" ] && basename "$f" .rs; done | sort)
harnesses=$(for f in harness/tests/*.mjs; do [ -e "$f" ] && basename "$f" .mjs; done | sort)

selected() {
    [ -z "$wanted" ] && return 0
    for w in $wanted; do [ "$w" = "$1" ] && return 0; done
    return 1
}

if [ "$mode" = list ]; then
    echo "unit      cargo test --lib"
    for f in $features; do echo "feature   $f"; done
    for h in $harnesses; do echo "harness   $h"; done
    exit 0
fi

failed=""
note() { printf '\n== %s\n' "$1"; }
fail() { failed="$failed $1"; }

if [ "$mode" != harness ]; then
    if [ "$mode" = unit ] || selected unit; then
        note "unit"
        cargo test --lib -- --test-threads=1 || fail unit
    fi
fi

if [ "$mode" = all ]; then
    for f in $features; do
        selected "$f" || continue
        note "feature $f"
        cargo test --test "$f" -- --test-threads=1 || fail "$f"
    done
fi

if [ "$mode" != unit ]; then
    for h in $harnesses; do
        selected "$h" || continue
        note "harness $h"
        node "harness/tests/$h.mjs" || fail "$h"
    done
fi

printf '\n'
if [ -n "$failed" ]; then
    echo "FAILED:$failed"
    exit 1
fi
echo "all suites passed"
